# accounting-tax-service local defaults (match trading-infra-deploy)
# Requires JDK 21; Maven uses JAVA_HOME.
SERVER_PORT=8086
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
REDIS_ADDR=localhost:6379
TAX_RATE=0.10
LOG_LEVEL=INFO
OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
